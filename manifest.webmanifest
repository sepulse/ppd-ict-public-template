{
  "name": "PPD-ICT - Portal Unit ICT PPD Contoh",
  "short_name": "PPD-ICT",
  "description": "Portal pengurusan laporan, dashboard, peta dan utiliti ICT untuk Pejabat Pendidikan Daerah Contoh.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0c0e12",
  "theme_color": "#0c0e12",
  "lang": "ms-MY",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": [
    "education",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png?v=10",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png?v=10",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png?v=10",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512-maskable.png?v=10",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg?v=10",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Papan Pemuka JTK",
